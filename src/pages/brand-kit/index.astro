---
import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';
import ModeToggle from '../../components/ui/ModeToggle.astro';
import { PRINCIPAL } from '../../lib/site';

const semantic = [
  { t: '--color-background', r: 'The page' },
  { t: '--color-surface', r: 'A panel on it' },
  { t: '--color-surface-raised', r: 'A panel on that' },
  { t: '--color-text', r: 'Ink' },
  { t: '--color-text-muted', r: 'Supporting prose' },
  { t: '--color-text-faint', r: 'Metadata' },
  { t: '--color-primary', r: 'Links, marks, the act' },
  { t: '--color-accent', r: 'Scarce. Once per screen.' },
  { t: '--color-border', r: 'Quiet division' },
  { t: '--color-rule', r: 'Structural division' },
];
const named = [
  { t: '--color__navy-ink', n: 'From the jacket in the headshot' },
  { t: '--color__grey-warm', n: 'From the backdrop in the headshot' },
  { t: '--color__brass', n: 'Card — the single accent' },
  { t: '--color__signal-blue', n: 'Sheet — links and the email only' },
  { t: '--color__dawn', n: 'Aperture — the terminator' },
  { t: '--color__sar-cyan', n: 'Aperture — the instrument' },
];
const type = [
  { t: '--font-display', l: 'Display', s: 'A pragmatic approach to capital.' },
  { t: '--font-body', l: 'Body', s: 'A family of entrepreneurs, scientists, operators, and founders.' },
  { t: '--font-data', l: 'Data', s: '15% · A/D/A · 78746' },
];
---
<BaseThemeLayout title="Brand kit — Meridian" description="Colour, type and the one photograph, in all three modes." theme="card" mode="light">
  <header class="chrome"><a class="back" href="/">&larr; Directions</a><ModeToggle /></header>
  <main class="wrap" id="main">
    <p class="eyebrow">Brand kit</p>
    <h1>There was no brand. This is the proposal.</h1>
    <p class="lede">
      Every colour on the live site is the stock editor swatch set &mdash; defaults
      nobody chose. So the palette below is drawn from the one considered visual
      the client owns: the headshot. Navy jacket, warm grey backdrop, white shirt.
      Toggle the mode control; everything here re-resolves live.
    </p>

    <section>
      <h2>The photograph <span class="hn">the source of the palette</span></h2>
      <div class="portrait-row">
        <img src={PRINCIPAL.portrait} alt={PRINCIPAL.portrait_alt} width="180" height="180" />
        <ul class="pulled">
          <li><span class="chip" style="background:var(--color__navy-ink)"></span>Jacket &rarr; ink and ground</li>
          <li><span class="chip" style="background:var(--color__grey-warm)"></span>Backdrop &rarr; muted text</li>
          <li><span class="chip" style="background:var(--color__shirt)"></span>Shirt &rarr; raised surface</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>Semantic colour <span class="hn">what components read</span></h2>
      <ul class="sw">
        {semantic.map((s) => (
          <li><span class="chip" style={`background:var(${s.t})`}></span>
            <span class="m"><code>{s.t}</code><span>{s.r}</span></span></li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Named colour <span class="hn">raw, never read by a component</span></h2>
      <ul class="sw">
        {named.map((s) => (
          <li><span class="chip" style={`background:var(${s.t})`}></span>
            <span class="m"><code>{s.t}</code><span>{s.n}</span></span></li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Type <span class="hn">three faces, not forty</span></h2>
      <ul class="ty">
        {type.map((t) => (
          <li><span class="tk"><code>{t.t}</code> {t.l}</span>
            <span class="ts" style={`font-family:var(${t.t})`}>{t.s}</span></li>
        ))}
      </ul>
    </section>
  </main>
</BaseThemeLayout>
<style>
  .chrome { display:flex; align-items:center; justify-content:space-between; padding:1.4rem var(--page-gutter); border-bottom:1px solid var(--color-border); }
  .back { font-size:0.8125rem; color:var(--color-text-muted); text-decoration:none; }
  .back:hover { color:var(--color-accent); }
  .wrap { max-width:var(--page-measure); margin:0 auto; padding:clamp(2.5rem,7vw,5rem) var(--page-gutter) 5rem; }
  .eyebrow { margin:0 0 1rem; font-family:var(--font-eyebrow); font-size:0.6875rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--color-accent); }
  h1 { margin:0; font-family:var(--font-display); font-weight:400; font-size:clamp(2rem,5vw,3.25rem); line-height:1.05; }
  .lede { margin:1.25rem 0 0; max-width:60ch; font-size:1.0625rem; line-height:1.65; color:var(--color-text-muted); }
  section { margin-top:3.5rem; padding-top:2rem; border-top:1px solid var(--color-rule); }
  h2 { margin:0 0 1.25rem; font-family:var(--font-display); font-weight:400; font-size:1.5rem; display:flex; flex-wrap:wrap; gap:0.75rem; align-items:baseline; }
  .hn { font-family:var(--font-eyebrow); font-size:0.625rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--color-text-faint); }
  code { font-family:var(--font-data); font-size:0.8125em; color:var(--color-accent); }
  .chip { width:2.5rem; height:2.5rem; flex:0 0 auto; border:1px solid var(--color-border); display:inline-block; }
  .sw { list-style:none; margin:0; padding:0; display:grid; gap:0.75rem; grid-template-columns:1fr; }
  @media (min-width:44rem){ .sw { grid-template-columns:repeat(2,1fr); } }
  .sw li { display:flex; gap:0.85rem; align-items:center; }
  .m { display:flex; flex-direction:column; gap:0.1rem; }
  .m span { font-size:0.8125rem; color:var(--color-text-muted); }
  .portrait-row { display:flex; gap:2rem; flex-wrap:wrap; align-items:center; }
  .portrait-row img { border-radius:999px; }
  .pulled { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:0.75rem; }
  .pulled li { display:flex; align-items:center; gap:0.75rem; font-size:0.875rem; color:var(--color-text-muted); }
  .pulled .chip { width:1.75rem; height:1.75rem; }
  .ty { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:1.75rem; }
  .tk { display:block; font-size:0.75rem; color:var(--color-text-faint); margin-bottom:0.4rem; }
  .ts { display:block; font-size:clamp(1.25rem,3vw,1.875rem); line-height:1.3; }
</style>
