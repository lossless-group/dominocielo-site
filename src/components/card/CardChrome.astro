---
/* ============================================================================
 * CardChrome — the only chrome on the page.
 *
 * No nav. The page is one screen, so there is nowhere to navigate to. This is
 * the way back to the direction chooser plus the mode toggle, set small and
 * quiet in the top corner so the first thing the eye lands on is still the
 * name. No rule beneath it: the whole page spends exactly one hairline, and
 * it is spent above the contact block.
 *
 * Tokens read: --font-eyebrow, --color-text-muted, --color-text, --color-border.
 * ========================================================================== */
import ModeToggle from '../ui/ModeToggle.astro';

export interface Props {
  /** Where the direction chooser lives. */
  href?: string;
  label?: string;
}

const { href = '/', label = 'Directions' } = Astro.props;
---

<header class="chrome">
  <a class="chrome-back" href={href}>
    <span class="chrome-arrow" aria-hidden="true">&larr;</span>{label}
  </a>
  <ModeToggle />
</header>

<style>
  .chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .chrome-back {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-eyebrow);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 0.15rem;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .chrome-back:hover,
  .chrome-back:focus-visible {
    color: var(--color-text);
    border-bottom-color: var(--color-border);
  }

  .chrome-arrow {
    /* Nudged optically; the glyph sits high in this face. */
    transform: translateY(0.05em);
  }
</style>
